# Скопируйте в apps/miniapp/.env.local и заполните для локальной разработки.
# .env / .env.* игнорируются git (кроме .env.example). Только VITE_*-переменные
# попадают в клиентский бандл — НЕ кладите сюда секреты бэкенда/бота.

# Базовый URL backend API. Пусто => фронт работает на mock-данных (без сети).
# Прод: URL API-сервиса Railway (напр. https://api.refiessefit.app).
VITE_API_URL=http://localhost:3000

# Ссылка оплаты Tribute для Paywall. Пусто => кнопка оплаты скрыта.
VITE_TRIBUTE_LINK=

# ТОЛЬКО ДЛЯ DEV: подписанная строка initData для работы в обычном браузере
# вне Telegram. НИКОГДА не задавать в production-сборке (Cloudflare Pages).
# VITE_DEV_INIT_DATA=

# DSN Sentry для фронтового мониторинга (S4-2, ОПЦИОНАЛЬНО).
# Пусто => Sentry выключен (no-op). В проде задаётся в Cloudflare Pages env.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
