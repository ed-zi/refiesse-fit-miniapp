# PostgreSQL connection string
DATABASE_URL=postgresql://refiesse:refiesse@localhost:5432/refiesse_dev

# Telegram bot token — ключ HMAC-верификации initData (НЕ коммитить реальный!)
BOT_TOKEN=0000000000:dev-placeholder-bot-token

# Секрет подписи сессионных JWT
JWT_SECRET=dev-jwt-secret-change-me

# Время жизни JWT (формат @fastify/jwt)
JWT_EXPIRES_IN=1h

# Максимальный возраст auth_date в initData, секунды (default 86400 = 24ч)
# INIT_DATA_MAX_AGE_SEC=86400

# Разрешённый origin фронта; не задан => dev-режим, разрешено всё
# CORS_ORIGIN=https://miniapp.example.com

# ЮKassa (P1) — рублёвая касса. shopId + secretKey из ЛК (Настройки → API-ключ).
# Не заданы (любой из двух) => POST /api/payments/* отвечают 503 PAYMENTS_DISABLED.
# YOOKASSA_SHOP_ID=123456
# YOOKASSA_SECRET_KEY=live_or_test_secret_key
# return_url — куда ЮKassa вернёт пользователя после оплаты (Mini App).
# YOOKASSA_RETURN_URL=https://miniapp.example.com/paywall/return
# Автосписания (recurring) по расписанию. Default false — в MVP ручное продление.
# BILLING_AUTOCHARGE_ENABLED=false

# DEPRECATED (P1): API-ключ Tribute — HMAC-проверка подписи webhook (trbt-signature).
# Tribute больше не источник продаж (перешли на ЮKassa), роут сохранён до e2e ЮKassa.
# Не задан => POST /api/tribute/webhook отвечает 503 TRIBUTE_DISABLED.
# TRIBUTE_API_KEY=trbt-api-key-from-dashboard

# Токен ручных admin-операций (header x-admin-token: grant/revoke доступа).
# Не задан => /admin/* отвечают 503 ADMIN_DISABLED (если и ADMIN_TELEGRAM_IDS пуст).
# ADMIN_TOKEN=long-random-admin-token

# Telegram user id админов через запятую (напр. "111,222"). Эти пользователи
# открывают админку прямо в Telegram по своей личности, без x-admin-token
# (доступ по Bearer JWT). Пусто/не задан => список пуст.
# ADMIN_TELEGRAM_IDS=111111111,222222222

PORT=3000
NODE_ENV=development

# DSN Sentry (S4-2, ОПЦИОНАЛЬНО). Не задан => мониторинг ошибок выключен (no-op).
# dev/test/CI работают без Sentry. В проде задаётся в Railway Variables.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
