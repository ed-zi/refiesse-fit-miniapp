# Скопируйте в apps/bot/.env и заполните. Файл .env в .gitignore — в git не попадает.

# Токен бота от @BotFather (@refiessefit_bot). ОБЯЗАТЕЛЕН.
# Только env/secrets: не вставлять в код, docs, чаты, PR (см. docs/ops/bot-token-rotation.md).
BOT_TOKEN=

# URL Mini App для кнопки web_app.
# Необязателен; по умолчанию: https://ed-zi.github.io/refiesse-fit-miniapp/
WEBAPP_URL=

# Полный URL админ-страницы для кнопки web_app в /admin (только HTTPS).
# Напр.: https://api-xxx.up.railway.app/admin/ui
# Необязателен; не задан → /admin отвечает «Админка ещё не настроена.».
ADMIN_URL=

# Whitelist админов: Telegram user id через запятую (тот же формат, что у API).
# Необязателен; пусто → /admin никого не пускает (покажет отправителю его ID).
# Напр.: 111111111,222222222
ADMIN_TELEGRAM_IDS=
